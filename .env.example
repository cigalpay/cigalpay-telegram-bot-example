# From @BotFather
BOT_TOKEN=
# Your own Telegram chat id: paid orders are sent there. Send /start to @userinfobot to get it.
# Start a chat with your bot once first, so it's allowed to message you.
MERCHANT_CHAT_ID=

# Where CigalPay can reach this server over HTTPS (it posts to /cigalpay/notify)
PUBLIC_URL=https://your-server.example.com
PORT=3000

# CigalPay dashboard > Settings > API credentials
CIGALPAY_ACCOUNT_ID=
CIGALPAY_NOTIFICATION_SECRET=

PRODUCT_NAME=Coffee beans, 1 kg
PRODUCT_DESCRIPTION=freshly roasted, shipped within 2 days
PRODUCT_PRICE=24.90
PRODUCT_CURRENCY=EUR
